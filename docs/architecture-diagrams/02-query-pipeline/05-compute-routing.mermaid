---
title: ProximaDB - Compute Routing (ComputeScheduler::route_select)
---
flowchart TD
    SQL["SQL arrives\n(pgwire:5433 or REST)"] --> LOWER["relational_pipeline.rs\nSQL → logical plan"]
    LOWER --> SCHED["ComputeScheduler::route_select\n(query/compute_scheduler.rs:329)"]

    SCHED --> SHAPE{"Inspect QueryShape\nCardinalityClass (48)\nPartitionFanout (87)"}
    SHAPE -->|"parquet-backed table\n(warehouse / MATERIALIZE)"| DF["DataFusion OLAP backend\nsrc/datafusion/\n• proxima_table_provider.rs\n• proxima_scan_exec.rs (PAX-native scan TD-OLAP-1)\n• predicate_pushdown / logical_lowering"]
    SHAPE -->|"vector/point-lookup / non-parquet"| NATIVE["Native Volcano engine\nsrc/query/execution/engine.rs\n(row-wise; OLTP floor)"]
    SHAPE -->|"vector / ANN"| ANN["Vector engines\nstorage/engines/ (SST,HELIX,NOVA;\nVIPER deprecated: existing collections only)"]

    DF --> RRP["RoutedReadPlan\nSelectRouteDecision (189)"]
    NATIVE --> RRP
    ANN --> RRP

    RRP --> EXEC["ExecNode tree\nrelational-executor/lib.rs (ExecNode)"]
    EXEC --> DIST["Distributed shuffle\ncrates/query/proximadb-query/src/distributed/shuffle.rs\n(ShuffleKey partitioning)"]
    EXEC --> RESULT["Result set (Arrow RecordBatch / records)"]

    classDef seam fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    class DF,NATIVE,ANN seam