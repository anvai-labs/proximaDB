---
title: ProximaDB - Storage Engine Internal Architecture
---
graph TB
    subgraph "Engine Factory (src/storage/engines/factory.rs)"
        FACTORY["StorageEngineFactory\nselect_engine(workload, config) → Engine"]
    end

    subgraph "SST Engine (src/storage/engines/sst/)"
        direction TB
        SST_ROOT["SSTEngine - Hybrid Columnar\nWrite-optimized · OLTP · ProximaBlocks"]
        SST_WRITE["SST Write Path\n1. Append to active segment\n2. Build PAX columnar blocks\n3. Update zone maps\n4. Sync footer"]
        SST_READ["SST Read Path\n1. Zone-map prune\n2. Bloom-filter check\n3. PAX scan (column projection)\n4. Predicate pushdown"]
        SST_COMPACT["SST Compaction\nL0→L1 merge sort\nKey-range partitioning\nTombstone GC"]
        SST_ROOT --> SST_WRITE
        SST_ROOT --> SST_READ
        SST_ROOT --> SST_COMPACT
    end

    subgraph "HELIX Engine (src/storage/engines/helix/)"
        HELIX_ROOT["HELIX Engine\nHNSW-indexed · ANN-optimized\nGraph-based navigation"]
        HELIX_INDEX["HNSW Index\nMulti-layer graph\nPruned neighbor edges\nEfConstruction tuning"]
        HELIX_STORE["Segment Store\nPAX blocks w/ vector columns\nDistance-prefetch"]
        HELIX_ROOT --> HELIX_INDEX
        HELIX_ROOT --> HELIX_STORE
    end

    subgraph "NOVA Engine (src/storage/engines/nova/)"
        NOVA_ROOT["NOVA Engine\nQuantized Columnar\nSQ8/RaBitQ native"]
        NOVA_ENCODE["Quantized Encoding\nSQ8: 8-bit uniform\nRaBitQ: stochastic 1-bit\nPer-segment codebook"]
        NOVA_SEARCH["Progressive Search\nCoarse quant → Fine rerank\nf32 refinement pass"]
        NOVA_ROOT --> NOVA_ENCODE
        NOVA_ROOT --> NOVA_SEARCH
    end

    subgraph "VIPER Engine (src/storage/engines/viper/)"
        VIPER_ROOT["VIPER Engine (deprecated, ADR-093)\nParquet Columnar · existing collections only"]
        VIPER_PARQUET["Parquet Writer\nArrow RecordBatch → Parquet\nRow-group sizing\nDictionary encoding"]
        VIPER_ICEBERG["Iceberg Integration\nManifest management\nSnapshot isolation\nTime-travel"]
        VIPER_ROOT --> VIPER_PARQUET
        VIPER_ROOT --> VIPER_ICEBERG
    end

    subgraph "Experimental Engines"
        RAPTOR["RAPTOR (exp)\nParallel Tiered Storage\nMatrix-optimized · PXK adaptive"]
        SWIFT["SWIFT (exp)\nHierarchical Superblocks\nFast traversal · Hot cache"]
    end

    subgraph "PAX Block Format (crates/storage/proximadb-block-format/)"
        PAX["ProximaBlock Format\n├── Header (magic, version, schema)\n├── Column Chunks (encoded arrays)\n│   ├── Vector columns (f32/f16/u8)\n│   ├── Scalar columns (int, float, string)\n│   └── Metadata columns (timestamps, flags)\n├── Zone Maps (min/max/null per column)\n├── Bloom Filter (optional)\n└── Footer (offsets, stats, checksum)"]
    end

    subgraph "Object Store (crates/storage/proximadb-object-store/)"
        OBJ["ProximaObjectStore\n├── S3 backend\n├── Azure Blob backend\n├── GCP backend\n├── Local FS backend\nRanged reads · Access tiers\nDrPathBuilder prefix:\n  data/{tenant}/{ns}/..."]
    end

    subgraph "WAL & Memtable (src/storage/persistence/)"
        WAL_WRITE["WAL Writer\nAppend-only log\nConfigurable sync:\n  immediate | batch | async"]
        MEMTABLE["Memtable\nLock-free concurrent\nSkipList | BTree | ART\nAuto-flush trigger"]
        FLUSH["FlushMaterializer\nWAL segment → PAX blocks\nSorted flush (LSN order)\nDelta-merge with existing"]
    end

    subgraph "Cache (src/storage/cache/)"
        CACHE["Cache Layer\n├── Query Result Cache\n├── Footer/Metadata Cache\n├── Block Cache\n├── CrossCacheOrchestrator\n│   (global budget + eviction)\n└── Trace-driven sizing"]
    end

    FACTORY --> SST_ROOT
    FACTORY --> HELIX_ROOT
    FACTORY --> NOVA_ROOT
    FACTORY --> VIPER_ROOT
    FACTORY --> RAPTOR
    FACTORY --> SWIFT
    SST_ROOT --> PAX
    HELIX_ROOT --> PAX
    NOVA_ROOT --> PAX
    VIPER_ROOT --> VIPER_PARQUET
    PAX --> OBJ
    WAL_WRITE --> MEMTABLE
    MEMTABLE --> FLUSH
    FLUSH --> PAX
    SST_ROOT --> OBJ
    HELIX_ROOT --> OBJ
    NOVA_ROOT --> OBJ
    VIPER_ROOT --> OBJ
    OBJ --> CACHE
    SST_READ --> CACHE

    classDef factory fill:#ffcc80,stroke:#e65100
    classDef engine fill:#ef9a9a,stroke:#d32f2f
    classDef pax fill:#b39ddb,stroke:#7e57c2
    classDef obj fill:#90a4ae,stroke:#37474f
    classDef wal fill:#a5d6a7,stroke:#2e7d32
    classDef cache fill:#80deea,stroke:#00838f
    classDef exp fill:#e0e0e0,stroke:#9e9e9e

    class FACTORY factory
    class SST_ROOT,SST_WRITE,SST_READ,SST_COMPACT,HELIX_ROOT,HELIX_INDEX,HELIX_STORE,NOVA_ROOT,NOVA_ENCODE,NOVA_SEARCH,VIPER_ROOT,VIPER_PARQUET,VIPER_ICEBERG engine
    class PAX pax
    class OBJ obj
    class WAL_WRITE,MEMTABLE,FLUSH wal
    class CACHE cache
    class RAPTOR,SWIFT exp
