---
title: ProximaDB - Storage Layer Component Diagram
---
graph TB
    subgraph "Storage Facade"
        STORE_ENGINE["🟦 Storage Engine\nsrc/storage/engine.rs\n(55K loc)\n- StorageEngine trait impl\n- Engine lifecycle mgmt\n- Flush coordination"]
        STORE_MOD["🟦 Storage Module\nsrc/storage/mod.rs\n- Public API surface\n- Engine registry"]
        SCAN_STRAT["🟦 Scan Strategy\nsrc/storage/scan_strategy.rs\n- Index-aware scan planning\n- Predicate splitting"]
    end

    subgraph "Engine Factory & Selection"
        FACTORY["🟧 Engine Factory\nsrc/storage/engines/factory.rs\n- Engine instantiation\n- Runtime selection\n- Feature-gated engines"]
        ENG_CAPS["🟧 Engine Capabilities\nsrc/storage/engine_capabilities.rs\n(24K loc)\n- Capability declaration\n- Compatibility matrix"]
    end

    subgraph "Vector Search Engines (Pax-Based)"
        SST["🟩 SST Engine\nsrc/storage/engines/sst/\n- Stable Storage Tier\n- Primary vector engine\n- HNSW index\n- PAX block format"]
        HELIX["🟩 HELIX Engine\nsrc/storage/engines/helix/\n- Helical index\n- Hybrid graph+vector\n- Co-design optimized"]
        NOVA["🟩 NOVA Engine\nsrc/storage/engines/nova/\n- New Observable Vector Architecture\n- SIMD-optimized\n- Freshness-optimized"]
        VIPER["🟥 VIPER Engine (deprecated, ADR-093)\nsrc/storage/engines/viper/\n- Vector index persistence engine\n- Specialized compaction"]
        RAPTOR["🟩 RAPTOR Engine (exp)\n- Feature-gated\n- experimental-engines"]
        SWIFT["🟩 SWIFT Engine (exp)\n- Feature-gated\n- experimental-engines"]

    end

    subgraph "PAX Block Format"
        PAX_BLOCK["🟪 PAX Block Format\ncrates/storage/proximadb-block-format\n- Custom columnar layout\n- Footer-based metadata\n- Zone maps\n- Ranged-read capable"]
        PAX_SEGMENTS["🟪 PAX Segments\nsrc/storage/formats/pax_segments/\n- Segment scanner\n- Compression codec\n- Quantized reader"]
        BLOCK_WRITER["🟪 Block Writer\n- Flush materialization\n- Columnar encoding"]
    end

    subgraph "Write Path"
        WAL["🔴 Write-Ahead Log\nsrc/storage/persistence/write_ahead_log/\n- wal_engine.rs (127K loc)\n- wal_operations.rs (149K loc)\n- Durable write ordering\n- Delta management"]
        MEMTABLE["🔴 Memtable\nsrc/storage/memtable/\n- In-memory buffer\n- Indexed writes\n- Background flush trigger"]
        FLUSH_MAT["🔴 Flush Materializer\nsrc/storage/flush_materializer.rs\n- Memtable→PAX block\n- Sort/compress/write\n- Footer generation"]
        TX_COORD["🔴 Transaction Coordinator\nsrc/storage/transaction_coordinator.rs\n(54K loc)\n- Multi-engine writes\n- TTL/tombstone management"]
        WRITE_FENCE["🔴 Write Fence\nsrc/storage/write_fence.rs\n- Concurrency guard"]
    end

    subgraph "Cache Layer"
        HOT_CACHE["🟡 Hot Cache\nsrc/storage/cache/\n- LRU/LFU eviction\n- Footer cache\n- Tenant-scoped\n- IoStats emission"]
        BLOCK_CACHE["🟡 Block Cache\ncrates/foundation/proximadb-cache\n- Generic cache traits\n- Eviction policies"]
    end

    subgraph "Object Store Abstraction"
        OBJ_STORE["🟤 Object Store Trait\ncrates/storage/proximadb-object-store\n- Async read/write\n- Multi-cloud (S3/Azure/GCP)\n- Range reads\n- Access tier support"]
        DR_PATH["🟤 DrPathBuilder\nsrc/storage/trait_components/path_resolver.rs\n- data/{tenant}/{ns}/...\n- Tenant isolation\n- Never raw paths"]
        STORAGE_PORTS["🟤 Storage Ports\ncrates/storage/proximadb-storage-ports\n- WriteableStorage\n- ReadableStorage\n- StorageHandle"]
        FILESYSTEM["🟤 Filesystem Types\ncrates/storage/proximadb-storage-filesystem-types\n- Local/POSIX\n- S3 adapter\n- Azure Blob adapter"]
    end

    subgraph "Iceberg / Warehouse Path"
        ICEBERG_ENG["🟢 Iceberg Engine\ncrates/storage/proximadb-iceberg-engine\n- Iceberg manifest mgmt\n- Parquet write paths\n- Snapshot isolation"]
        ICEBERG_STORE["🟢 Iceberg Store\nsrc/storage/entity_store/iceberg/\n- IcebergTableStore\n- Parquet scan"]
    end

    subgraph "Trait Components"
        TRAIT_COMP["🔷 Storage Traits\nsrc/storage/traits/\n- Engine trait\n- Search trait\n- Scan trait\n- Write trait"]
        TRAIT_IO["🔷 I/O Components\nsrc/storage/trait_components/\n- PathResolver\n- FileManager\n- BlockAccess"]
    end

    subgraph "Storage Operations"
        STORE_OPS["⬜ Storage Operations\ncrates/storage/proximadb-storage-operations\n- get_record\n- scan_records\n- upsert_records\n- delete_records"]
        STORE_KV["⬜ KV Store\ncrates/storage/proximadb-storage-kv\n- Key-value backend\n- Bytes-oriented"]
        STORE_STRAT["⬜ Storage Strategy\ncrates/storage/proximadb-storage-strategy\n- Tiering decisions\n- Hot/warm/cold"]
        STORE_OPT["⬜ Storage Optimization\ncrates/storage/proximadb-storage-optimization\n- Compaction\n- Segment merging"]
    end

    subgraph "Tenant Infrastructure"
        TENANT_CTX["🏢 TenantContext\ncrates/foundation/proximadb-tenant\n- Multi-tenant isolation\n- Billing boundary\n- I/O attribution"]
        STORE_TENANT["🏢 Tenant Storage\ncrates/storage/proximadb-storage-tenant\n- Tenant store management"]
        TIERING["🏢 Storage Tiering\nsrc/storage/tiering/\n- Hot/Warm/Cold tiers\n- Access-based migration"]
    end

    %% Write Flow
    STORE_ENGINE --> MEMTABLE
    MEMTABLE --> WAL
    MEMTABLE --> FLUSH_MAT
    WAL --> OBJ_STORE
    FLUSH_MAT --> PAX_BLOCK
    FLUSH_MAT --> BLOCK_WRITER

    %% Read Flow
    SST --> PAX_BLOCK
    HELIX --> PAX_BLOCK
    NOVA --> PAX_BLOCK
    VIPER --> PAX_BLOCK
    PAX_BLOCK --> OBJ_STORE
    PAX_BLOCK --> HOT_CACHE

    %% Engine Selection
    STORE_ENGINE --> FACTORY
    FACTORY --> SST
    FACTORY --> HELIX
    FACTORY --> NOVA
    FACTORY --> VIPER
    FACTORY --> RAPTOR
    FACTORY --> SWIFT

    %% Warehouse Path
    FACTORY --> ICEBERG_ENG
    ICEBERG_ENG --> ICEBERG_STORE
    ICEBERG_STORE --> OBJ_STORE

    %% Path Construction
    STORE_ENGINE --> DR_PATH
    OBJ_STORE --> DR_PATH
    DR_PATH --> TENANT_CTX

    %% Trait boundaries
    STORE_ENGINE --> TRAIT_COMP
    SCAN_STRAT --> TRAIT_COMP
    TRAIT_COMP --> STORE_OPS
    STORE_OPS --> STORE_KV
    STORE_OPS --> STORE_STRAT

    %% Transaction
    STORE_ENGINE --> TX_COORD
    TX_COORD --> WAL
    TX_COORD --> WRITE_FENCE

    %% Cache
    PAX_BLOCK --> HOT_CACHE
    HOT_CACHE --> BLOCK_CACHE

    classDef facade fill:#bbdefb,stroke:#1565c0
    classDef factory fill:#ffe0b2,stroke:#f57c00
    classDef engine fill:#c8e6c9,stroke:#2e7d32
    classDef pax fill:#e1bee7,stroke:#7b1fa2
    classDef write fill:#ffcdd2,stroke:#d32f2f
    classDef cache fill:#fff9c4,stroke:#f9a825
    classDef obj fill:#d7ccc8,stroke:#5d4037
    classDef iceberg fill:#b2dfdb,stroke:#00695c
    classDef trait fill:#b3e5fc,stroke:#0288d1
    classDef ops fill:#f5f5f5,stroke:#9e9e9e
    classDef tenant fill:#ffccbc,stroke:#e64a19

    class STORE_ENGINE,STORE_MOD,SCAN_STRAT facade
    class FACTORY,ENG_CAPS factory
    class SST,HELIX,NOVA,VIPER,RAPTOR,SWIFT engine
    class PAX_BLOCK,PAX_SEGMENTS,BLOCK_WRITER pax
    class WAL,MEMTABLE,FLUSH_MAT,TX_COORD,WRITE_FENCE write
    class HOT_CACHE,BLOCK_CACHE cache
    class OBJ_STORE,DR_PATH,STORAGE_PORTS,FILESYSTEM obj
    class ICEBERG_ENG,ICEBERG_STORE iceberg
    class TRAIT_COMP,TRAIT_IO trait
    class STORE_OPS,STORE_KV,STORE_STRAT,STORE_OPT ops
    class TENANT_CTX,STORE_TENANT,TIERING tenant
