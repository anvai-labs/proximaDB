---
title: ProximaDB - System Deployment Diagram
---
graph TB
    subgraph "Client Layer"
        PY_SDK["🐍 Python SDK\nclients/python/\n- proximadb_sdk\n- Embedding providers\n- Chunking strategies\n- Sync + Async clients"]
        RUST_CLIENT["🦀 Rust Client\nclients/rust/\n- REST client (genrest.rs)\n- Auto-generated from OpenAPI"]
        GO_SDK["🔵 Go SDK\n(gen-go-sdk)\n- Proto-generated client\n- gRPC + REST"]
        TS_SDK["🟦 TypeScript SDK\nclients/nodejs-embedded/\n- Embedded Node.js\n- WASM bindings"]
        SPARK["⚡ Spark JNI\ncrates/binding/proximadb-spark-jni\n- Spark integration"]
        PG_CLIENT["🐘 PostgreSQL Client\n- Any PG driver\n- psql, JDBC, etc."]
    end

    subgraph "API Gateway (Kubernetes Pod)"
        L7["🔷 Layer 7 LB\n- TLS termination\n- Cert management\n- Rate limiting"]
    end

    subgraph "ProximaDB Server Process"
        subgraph "Port Binding"
            P5678["Port :5678\nREST (HTTP/1.1)\n+ gRPC (HTTP/2)\n+ Arrow Flight"]
            P5433["Port :5433\npgwire\n(PostgreSQL Protocol)"]
        end

        subgraph "Server Runtime"
            MULTI["MultiServer\n- TCP multiplexing\n- Graceful shutdown\n- Health checks"]
            TOKIO["Tokio Runtime\n- Async I/O\n- Work-stealing scheduler\n- Thread pool"]
        end

        subgraph "Core Processing"
            CATALOG["CatalogManager\n- DDL coordination\n- Schema registry\n- Generation-fenced"]
            COMPUTE["ComputeScheduler\n- DataFusion (OLAP)\n- Volcano (OLTP)\n- Backend dispatch"]
            DML["DML Service\n- INSERT/UPDATE/DELETE\n- Write lane routing\n- Record validation"]
            SEARCH["Search Service\n- Vector search\n- Hybrid search\n- Result aggregation"]
        end

        subgraph "Storage Engines"
            VECTOR_ENG["Vector Engines\nSST | HELIX | NOVA\nVIPER: deprecated, existing collections only\n- HNSW/IVF indices\n- PAX block format\n- Quantization (SQ8/RaBitQ)"]
            ICEBERG["Iceberg Engine\n- Parquet tables\n- Iceberg manifests\n- Snapshot isolation"]
            ORION["ORION Graph Engine\n- Property graph\n- Traversal engine"]
        end

        subgraph "Persistence Backend"
            WAL["WAL Engine\n- Durable writes\n- Delta management\n- LSN ordering"]
            FLUSH["Flush Materializer\n- Memtable→PAX blocks\n- Footer generation\n- Object store writes"]
        end
    end

    subgraph "Infrastructure Layer"
        S3["☁️ Amazon S3\n- Object storage\n- Range reads\n- Access tiers"]
        AZURE["☁️ Azure Blob\n- ADLS Gen2\n- Flat keys\n- Access tiers"]
        GCP["☁️ GCP Cloud Storage\n- Object storage\n- Range reads"]
        LOCAL["💾 Local Disk\n- Local NVMe\n- /data mount\n- Footer cache"]
        POSTGRES["🐘 PostgreSQL\n- External catalog\n- Reference data"]
        KAFKA_INFRA["📨 Kafka\n- Event streaming\n- CDC source"]
    end

    subgraph "Observability Stack"
        PROM["📊 Prometheus\n- Metrics scrape\n- KSU/KRU/KOU/KIU/KU\n- Billing telemetry"]
        GRAFANA["📈 Grafana\n- Dashboards\n- Alerting"]
        JAEGER["🔍 Jaeger\n- Distributed tracing\n- I/O trace analysis"]
    end

    subgraph "Control Plane"
        ADMIN["🖥️ Admin UI\ncrates/platform/proximadb-admin-ui"]
        MCP["🤖 MCP Server\ncrates/platform/proximadb-mcp\n- Model Context Protocol"]
    end

    %% Client to Server
    PY_SDK --> L7
    RUST_CLIENT --> L7
    GO_SDK --> L7
    TS_SDK --> L7
    SPARK --> L7
    PG_CLIENT --> P5433

    L7 --> P5678
    P5678 --> MULTI
    P5433 --> MULTI

    MULTI --> CATALOG
    MULTI --> COMPUTE
    MULTI --> DML
    MULTI --> SEARCH

    COMPUTE --> VECTOR_ENG
    COMPUTE --> ICEBERG
    DML --> WAL
    DML --> VECTOR_ENG
    SEARCH --> VECTOR_ENG

    WAL --> FLUSH
    FLUSH --> VECTOR_ENG
    VECTOR_ENG --> S3
    VECTOR_ENG --> AZURE
    VECTOR_ENG --> GCP
    VECTOR_ENG --> LOCAL

    ICEBERG --> S3
    ICEBERG --> AZURE
    ICEBERG --> GCP

    ORION --> VECTOR_ENG

    MULTI --> PROM
    PROM --> GRAFANA
    MULTI --> JAEGER

    ADMIN --> MULTI
    MCP --> MULTI

    KAFKA_INFRA --> MULTI

    classDef client fill:#a5d6a7,stroke:#2e7d32
    classDef lb fill:#90caf9,stroke:#1565c0
    classDef server fill:#ffcc80,stroke:#f57c00
    classDef infra fill:#ef9a9a,stroke:#d32f2f
    classDef obs fill:#ce93d8,stroke:#7b1fa2
    classDef control fill:#bcaaa4,stroke:#5d4037

    class PY_SDK,RUST_CLIENT,GO_SDK,TS_SDK,SPARK,PG_CLIENT client
    class L7 lb
    class P5678,P5433,MULTI,TOKIO,CATALOG,COMPUTE,DML,SEARCH,VECTOR_ENG,ICEBERG,ORION,WAL,FLUSH server
    class S3,AZURE,GCP,LOCAL,POSTGRES,KAFKA_INFRA infra
    class PROM,GRAFANA,JAEGER obs
    class ADMIN,MCP control
