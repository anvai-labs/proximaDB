---
title: ProximaDB - System Deployment Diagram (C4 Level 1)
---
graph TB
    subgraph "SDK Clients"
        PYTHON["🐍 Python SDK\n(proximadb-sdk)\n- Embedding Providers\n- Chunking Strategies\n- REST/gRPC/Arrow Flight transports"]
        RUST_SDK["🦀 Rust Client\n(genrest.rs)\n- REST bindings"]
        NODE["📦 Node.js Embedded\n- TS bindings\n- Direct C-FFI"]
        GO_SDK["🔷 Go SDK\n- Codegen REST client"]
        JVM["☕ JVM/Spark\n- Spark connector\n- JNI bridge"]
    end

    subgraph "Network Layer - Port Multiplexer :5678"
        MUX["TCP Multiplexer\nmultiplex/tcp_multiplexer.rs"]
        REST["REST API\nAxum HTTP/1.1\n:15678 internal"]
        GRPC["gRPC API\nTonic HTTP/2\n:15679 internal"]
        FLIGHT["Arrow Flight\nArrow IPC\n:5680"]
        PGWIRE["PostgreSQL Wire\npgwire protocol\n:5433"]
    end

    subgraph "Middleware Stack"
        AUTH["Auth Middleware\nJWT / API Keys / RBAC"]
        TENANT["Tenant Middleware\nTenantContext extraction"]
        RATE["Rate Limiter"]
        CORS["CORS"]
        METRICS_MW["Metrics Middleware"]
    end

    subgraph "Core Server - ProximaDB Instance"
        DB["ProximaDB\nsrc/database.rs\n- Lifecycle management\n- Bootstrap wiring"]
        CATALOG["Catalog Manager\nsrc/catalog/\n- Internal registry\n- Federated catalog\n- Iceberg REST"]
        SHARED["SharedServices\nsrc/network/shared_services.rs\n- Service composition root"]
    end

    subgraph "Query Pipeline"
        PG_SELECT["pgwire SELECT\npostgres/relational_pipeline.rs"]
        CS["ComputeScheduler\nsrc/query/compute_scheduler.rs\n- Route selection\n- Cost model\n- Backend dispatch"]
        SQL_FE["SQL Frontend\nsrc/query/sql_frontend/\n- Parser (171K)\n- Lowering"]
        OPT["Query Optimizer\nsrc/query/query_optimizer.rs\n(124K loc)"]
        EXEC["Execution Engine\nsrc/query/execution/engine.rs\n- NativeVolcanoEngine\n- DataFusion backend"]
    end

    subgraph "Storage Layer"
        SE["StorageEngine\nsrc/storage/engine.rs"]
        TRAITS["Storage Traits\nsrc/storage/traits/\n- UnifiedStorageFormat\n- ISP-segregated traits"]
        WAL["Write-Ahead Log\nsrc/storage/persistence/write_ahead_log/"]
        MEMTABLE["Memtable\nsrc/storage/memtable/"]
        FLUSH["Flush Materializer\nsrc/storage/flush_materializer.rs"]
    end

    subgraph "Storage Engines"
        SST["SST Engine\nLSM-tree / ProximaBlocks\nOLTP optimized"]
        VIPER["VIPER Engine (deprecated, ADR-093)\nexisting collections only"]
        NOVA["NOVA Engine\nAdvanced columnar\nQuantization"]
        HELIX["HELIX Engine\nPCA + Hilbert curves\nHigh-dim"]
        ORION["ORION Engine\nGraph storage"]
    end

    subgraph "Index Layer"
        AXIS["AXIS Index Manager\nsrc/index/axis/\n- HNSW, IVF, Flat\n- Annoy, PQ\n- Index Factory"]
        GEO["Geo Index\n- Geohash\n- Spatial queries"]
        EDR["EDR Index\n- Entity dedup\n- Expansion"]
        TQ["TurboQuant Bridge\n- Quantized indices"]
    end

    subgraph "Object Storage"
        OBJ["Object Store\ncrates/storage/proximadb-object-store\n- S3 / Azure Blob / GCS"]
        ICEBERG["Iceberg Engine\ncrates/storage/proximadb-iceberg-engine\n- Manifest management\n- Parquet tables"]
        PAX["PAX Block Format\ncrates/storage/proximadb-block-format\n- Custom columnar"]
    end

    subgraph "Cluster (feature=cluster)"
        RAFT["Raft Consensus\nsrc/cluster/consensus.rs"]
        PL["Partition Lease\nsrc/cluster/partition_lease.rs\n(170K loc)"]
        RPC["Cluster RPC\nsrc/cluster/rpc/"]
        REPL["Replication\nsrc/cluster/replication.rs"]
    end

    subgraph "Services"
        DML["DML Service\nsrc/services/dml/\n(461K loc)"]
        COLL["Collection Manager\nsrc/services/collection/"]
        DDL["DDL Service\nsrc/services/ddl/"]
        SEARCH["Search Service\nsrc/services/search/"]
        RECORD["Record Store\nsrc/services/record_store.rs\n(180K loc)"]
    end

    %% Client connections
    PYTHON -->|REST/gRPC/Flight| MUX
    RUST_SDK -->|REST| MUX
    NODE -->|C-FFI| DB
    GO_SDK -->|REST| MUX
    JVM -->|JNI/REST| MUX

    %% Network routing
    MUX --> REST
    MUX --> GRPC
    MUX --> FLIGHT
    MUX --> PGWIRE

    %% Middleware chain
    REST --> AUTH --> TENANT --> RATE --> METRICS_MW
    GRPC --> AUTH --> TENANT --> RATE --> METRICS_MW

    %% Core routing
    AUTH --> DB
    DB --> SHARED
    SHARED --> CATALOG

    %% Query flow
    PGWIRE --> PG_SELECT
    PG_SELECT --> CS
    REST --> SQL_FE
    GRPC --> SQL_FE
    SQL_FE --> OPT
    OPT --> CS
    CS --> EXEC
    CS --> SE

    %% Storage flow
    EXEC --> SE
    SE --> TRAITS
    TRAITS --> SST
    TRAITS --> VIPER
    TRAITS --> NOVA
    TRAITS --> HELIX

    %% Write path
    DML --> WAL
    WAL --> MEMTABLE
    MEMTABLE --> FLUSH
    FLUSH --> SST
    FLUSH --> VIPER

    %% Index
    EXEC --> AXIS
    AXIS --> SST
    AXIS --> VIPER

    %% Object store
    SST --> OBJ
    VIPER --> OBJ
    VIPER --> ICEBERG
    SST --> PAX

    %% Cluster
    SHARED -.->|feature=cluster| RAFT
    RAFT -.-> PL
    PL -.-> RPC
    RPC -.-> REPL

    %% Services
    SHARED --> DML
    SHARED --> COLL
    SHARED --> DDL
    DML --> RECORD
    DML --> SEARCH

    classDef client fill:#e1f5fe,stroke:#0288d1
    classDef network fill:#fff3e0,stroke:#f57c00
    classDef core fill:#e8f5e9,stroke:#388e3c
    classDef query fill:#f3e5f5,stroke:#7b1fa2
    classDef storage fill:#fce4ec,stroke:#d81b60
    classDef index fill:#e0f2f1,stroke:#00695c
    classDef cluster fill:#fff9c4,stroke:#f9a825

    class PYTHON,RUST_SDK,NODE,GO_SDK,JVM client
    class MUX,REST,GRPC,FLIGHT,PGWIRE network
    class DB,CATALOG,SHARED core
    class PG_SELECT,CS,SQL_FE,OPT,EXEC query
    class SE,TRAITS,WAL,MEMTABLE,FLUSH,SST,VIPER,NOVA,HELIX,ORION,OBJ,ICEBERG,PAX storage
    class AXIS,GEO,EDR,TQ index
    class RAFT,PL,RPC,REPL cluster
