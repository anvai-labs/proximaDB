---
title: ProximaDB - Top-Level Architecture
---
graph TB
    subgraph "Clients & SDKs"
        SDK["🐍 Python SDK\n🍏 TS/Node SDK\n🦀 Rust SDK\n🔵 Go SDK"]
    end

    subgraph "Network Layer (Entry Points)"
        NET["🔌 MultiServer (port :5678 + :5433)\nREST (HTTP/1.1) · gRPC (HTTP/2) · Arrow Flight · pgwire"]
        MW["🛡️ Middleware Stack\nAuth → Tenant → Rate → TLS → Metrics → Backpressure"]
    end

    subgraph "Services Layer (Business Logic)"
        SVCS["⚙️ DML · Search · Operations · Collections · Table · Namespace · Events · Transaction"]
    end

    subgraph "Query Pipeline"
        QP["🔎 Parser → Optimizer → ComputeScheduler\n┌──────────────┬──────────────┐\n│ DataFusion   │ Volcano      │\n│ OLAP (DF)    │ OLTP (Native)│\n│ Parquet/     │ HNSW/PAX     │\n│ Iceberg      │ Vector       │\n└──────────────┴──────────────┘"]
    end

    subgraph "Storage Layer"
        STORE["💾 StorageEngine → Factory → Engines\nSST · HELIX · NOVA · VIPER(deprecated) · RAPTOR(exp)\n+ ORION Graph Engine\n+ Iceberg/DataWarehouse Engine"]
        PAX["📦 PAX Block Format\nColumnar layout · Zone maps · Footer metadata"]
        WAL["📝 WAL → Memtable → FlushMaterializer\nDelta management · LSN ordering"]
        CACHE["⚡ Cache Layer\nHot Cache · Footer Cache · Query Result Cache"]
    end

    subgraph "Index Layer"
        IDX["🧭 HNSW · IVF · Compact · AXIS (adaptive)\nDistance Kernels (SIMD f32/f16/u8)\nQuantization: SQ8 · RaBitQ · PQ"]
    end

    subgraph "Catalog & Control"
        CAT["📋 CatalogManager (generation-fenced)\nDDL · Schema Registry · Metadata · Cache"]
    end

    subgraph "Cluster & Distribution"
        CLUSTER["🌐 Partition Leases · Raft Consensus · Replication\nShuffle Keys · Scatter/Gather · CDC/Kafka"]
    end

    subgraph "AI & Intelligence"
        AI["🤖 LLM Integration · Text-to-SQL · RAG\nAutoML · Insights · NLP · Embedding Pipeline"]
    end

    subgraph "Security & Observability"
        SEC["🔒 JWT · RBAC · Federated Auth · SSO · TLS"]
        OBS["📊 Prometheus · Billing (KSU/KRU/KOU) · Tracing · Audit"]
    end

    subgraph "Object Storage (Decoupled)"
        OBJ["☁️ S3 · Azure Blob · GCP · Local\nFlat keys · Range reads · Access tiers\nTenantPath: data/{tenant}/{ns}/..."]
    end

    subgraph "Crates (Workspace)"
        CRATES["📚 foundation · horizontal · storage · query · modalities · control · platform · contracts · binding"]
    end

    %% Main flow
    SDK --> NET
    NET --> MW
    MW --> SVCS
    SVCS --> QP
    SVCS --> CAT
    QP --> STORE
    STORE --> IDX
    STORE --> PAX
    STORE --> CACHE
    WAL --> OBJ
    STORE --> OBJ
    CLUSTER --> CAT
    CLUSTER --> STORE
    AI --> QP
    AI --> SVCS
    SEC --> MW
    OBS --> NET
    OBS --> STORE
    CRATES -.-> STORE
    CRATES -.-> QP
    CRATES -.-> CAT
    CRATES -.-> IDX

    classDef client fill:#a5d6a7,stroke:#2e7d32
    classDef network fill:#90caf9,stroke:#1565c0
    classDef service fill:#ffcc80,stroke:#f57c00
    classDef query fill:#ce93d8,stroke:#7b1fa2
    classDef storage fill:#ef9a9a,stroke:#d32f2f
    classDef index fill:#80deea,stroke:#00838f
    classDef catalog fill:#a1887f,stroke:#4e342e
    classDef cluster fill:#fff176,stroke:#f9a825
    classDef ai fill:#b39ddb,stroke:#7e57c2
    classDef sec fill:#f48fb1,stroke:#c2185b
    classDef obj fill:#90a4ae,stroke:#37474f
    classDef crates fill:#e0e0e0,stroke:#616161

    class SDK client
    class NET,MW network
    class SVCS service
    class QP query
    class STORE,PAX,WAL,CACHE storage
    class IDX index
    class CAT catalog
    class CLUSTER cluster
    class AI ai
    class SEC,OBS sec
    class OBJ obj
    class CRATES crates
