# TD-PKG-1: directories the proximadb service user must own (mode 750).
# Single source of truth for the packaging contract:
#   - postinstall.sh (the fpm --after-install scriptlet) sources this file
#     from /etc/proximadb/ at package-install time;
#   - verify_rpm.sh / verify_deb.sh (pre-publish verifiers) read THIS repo
#     file to derive the expected rpm -V deviations and the stat asserts;
#   - release-smoke.yml derives CHOWN_DIRS on the host from this file.
CHOWN_DIRS="/var/lib/proximadb /var/log/proximadb"
