<?xml version="1.0" encoding="UTF-8"?>
<!--
  ProximaDB Windows Installer (WiX v4)

  This manifest creates an MSI installer for ProximaDB on Windows.
  Build with: wix build -d Version=0.2.0 proximadb.wxs -o proximadb-x64.msi

  Features:
  - Installs binaries to C:\Program Files\ProximaDB\
  - Creates config directory in C:\ProgramData\ProximaDB\
  - Adds binaries to PATH
  - Start menu shortcuts

  Note: WiX v4 has different UI extension handling than v3
  This version uses minimal built-in UI without external UI extensions
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ProximaDB" Version="$(var.Version)" Manufacturer="ProximaDB Contributors" UpgradeCode="74DA5FFA-FEC4-47C6-B49B-0633255780B8" Scope="perMachine">

    <SummaryInformation Description="ProximaDB - Cloud-native vector database" />

    <!-- Media: Single cabinet -->
    <Media Id="1" Cabinet="proximadb.cab" EmbedCab="yes" />

    <!-- Installation Directory: Program Files -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ProximaDB" />
    </StandardDirectory>

    <!-- Config Directory: ProgramData -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CONFIGDIR" Name="ProximaDB">
        <Component Id="ConfigDirComponent" Guid="8A3D5F2E-7B9C-4A2E-9F1D-6C8B3A7D5E9F">
          <CreateFolder />
          <RemoveFolder Id="RemoveConfigDir" On="uninstall" />
          <RegistryValue Root="HKMU" Key="Software\ProximaDB" Name="ConfigDir" Type="string" Value="installed" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Data Directory: ProgramData -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIR" Name="ProximaDBData">
        <Component Id="DataDirComponent" Guid="D13947D9-3F89-4E1E-9F5F-647390400C21">
          <CreateFolder />
          <RemoveFolder Id="RemoveDataDir" On="uninstall" />
          <RegistryValue Root="HKMU" Key="Software\ProximaDB" Name="DataDir" Type="string" Value="installed" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Main Feature: Binaries -->
    <Feature Id="Binaries" Title="ProximaDB Binaries" Level="1" AllowAbsent="no" Description="Core ProximaDB binaries and tools">
      <!-- Description for Add/Remove Programs -->
      <Feature Id="Binaries_Description" Title="ProximaDB" Description="Cloud-native vector database for AI applications" Level="1">

        <!-- Server Binary + the Windows service (TD-PKG-2: there was no
             ServiceInstall at all, so `Start-Service proximadb` failed). The
             service runs with an explicit config and data dir: its roots live
             in ProgramData (the shipped config's /tmp defaults are rebased by
             the data dir flag) instead of the current drive's temp tree. -->
        <Component Id="ServerComponent" Directory="INSTALLFOLDER" Guid="72DB93A3-5809-4B0B-9943-F557E3934990">
          <File Id="ServerFile" Source="proximadb-server.exe" KeyPath="yes" />
          <ServiceInstall
            Id="ProximaDBService"
            Name="proximadb"
            DisplayName="ProximaDB Server"
            Description="ProximaDB vector database service"
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Arguments="--config &quot;[CONFIGDIR]config.toml&quot; --data-dir &quot;[DATADIR]data&quot;"
          />
          <ServiceControl Id="StopProximaDBService" Name="proximadb" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>

        <!-- Benchmark Tool -->
        <Component Id="BenchComponent" Directory="INSTALLFOLDER" Guid="B037E945-4452-46B8-BD59-2D3657A88E03">
          <File Id="BenchFile" Source="proximadb-bench.exe" />
        </Component>

        <!-- Migration Tool -->
        <Component Id="MigrateComponent" Directory="INSTALLFOLDER" Guid="B94EA39B-5968-4AD5-AC08-88158E9A4E02">
          <File Id="MigrateFile" Source="proximadb-migrate.exe" />
        </Component>

        <!-- TD-PKG-2: the config installs into ProgramData, where the Start-menu
             shortcuts and the service look for it (it used to land next to the
             binaries in Program Files, which a non-elevated user cannot edit,
             while CONFIGDIR was created empty). -->
        <Component Id="ConfigComponent" Directory="CONFIGDIR" Guid="58303A7C-0A7C-4650-B4FC-0CCD86CC710D">
          <File Id="ConfigFile" Source="config.toml" />
        </Component>


        <!-- PATH Environment Variable -->
        <Component Id="PathComponent" Directory="INSTALLFOLDER" Guid="00203128-4665-47F1-8FF1-7C9F779CCE32">
          <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>

        <!-- Config and Data directories -->
        <ComponentRef Id="ConfigDirComponent" />
        <ComponentRef Id="DataDirComponent" />
      </Feature>
    </Feature>

    <!-- Start Menu Shortcuts -->
    <Feature Id="Shortcuts" Title="Start Menu Shortcuts" Level="1" Description="Start menu shortcuts for ProximaDB">
      <ComponentRef Id="ServerComponent" />
      <ComponentRef Id="ConfigComponent" />

      <Component Id="StartMenuComponent" Directory="ProgramMenuFolder" Guid="A80E321C-28B4-4765-960B-0A756E049E07">
        <Shortcut Id="ServerShortcut" Name="ProximaDB Server" Description="Start ProximaDB Server" Target="[INSTALLFOLDER]proximadb-server.exe" Arguments="--config &quot;[CONFIGDIR]config.toml&quot; --data-dir &quot;[DATADIR]data&quot;" WorkingDirectory="DATADIR" />
        <Shortcut Id="ConfigShortcut" Name="ProximaDB Config" Description="Edit ProximaDB Configuration" Target="notepad.exe" Arguments="[CONFIGDIR]config.toml" />
        <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ProximaDB\Installer" Name="installed" Type="integer" Value="1" KeyPath="no" />
      </Component>
    </Feature>

    <!-- Upgrade Detection -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of ProximaDB is already installed." Schedule="afterInstallExecute" />

    <!-- Launch Condition: Windows 10+ -->
    <Launch Condition="Installed OR (VersionNT >= 603)" Message="ProximaDB requires Windows 8.1 or later." />

    <!-- Installation UI: Minimal built-in -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="" />
    <WixVariable Id="WixUIBannerBmp" Value="" />
    <WixVariable Id="WixUIDialogBmp" Value="" />

  </Package>
</Wix>
